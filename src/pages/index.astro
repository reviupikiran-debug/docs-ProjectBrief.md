---
import Hero from "../components/Hero.astro";
import CTA from "../components/CTA.astro";

const cities = ["Jakarta", "Bandung", "Surabaya", "Yogyakarta"];
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <title>Undangan Digital Indonesia</title>
    <meta name="description" content="Undangan digital modern & elegan untuk seluruh kota di Indonesia" />
  </head>

  <body>

    <Hero
      title="Undangan Digital Modern"
      subtitle="Cepat, elegan, dan siap pakai untuk semua kota"
    />

    <section>
      <h2>Kota Layanan</h2>

      <ul>
        {cities.map((city) => (
          <li>
            <a href={`/undangan-digital/${city.toLowerCase()}`}>
              Undangan Digital {city}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CTA phone="628XXXXXXXXXX" />

  </body>
</html>