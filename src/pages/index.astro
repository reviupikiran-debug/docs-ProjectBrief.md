---
import Hero from "../components/Hero.astro";
import CTA from "../components/CTA.astro";
import { internalLinks } from "../data/links";
---

<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <title>Undangan Digital Indonesia</title>
    <meta name="description" content="Undangan digital modern & elegan untuk seluruh kota di Indonesia" />
  </head>

  <body>

    <Hero
      title="Undangan Digital Modern"
      subtitle="Cepat, elegan, dan siap pakai untuk semua kota"
    />

    <!-- CITY HUB (SEO LINK DISTRIBUTION) -->
    <section>
      <h2>Kota Layanan</h2>

      <ul>
        {internalLinks.cities.map((item) => (
          <li>
            <a href={item.url}>
              Undangan Digital {item.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- BLOG HUB (TOPICAL AUTHORITY BUILDER) -->
    <section>
      <h2>Artikel Populer</h2>

      <ul>
        {internalLinks.blog.map((item) => (
          <li>
            <a href={item.url}>
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <CTA phone="628XXXXXXXXXX" />

  </body>
</html>